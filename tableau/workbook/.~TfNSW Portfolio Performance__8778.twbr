      <aliases enabled='yes' />
      <column aggregation='CountD' caption='Portfolio Stage' datatype='string' name='[Calculation_0603259932229632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([current_phase])&#10;    OR TRIM([current_phase]) = &quot;&quot;&#10;THEN [pipeline_category]&#10;ELSE [current_phase]&#10;END' />
      </column>
      <column caption='Latest Budget Snapshot' datatype='boolean' name='[Calculation_0603259938246660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[budget_year] =&#10;{ FIXED [master_project_id (budget_project_snapshots.csv)] :&#10;    MAX([budget_year])&#10;}' />
      </column>
      <column caption='Completion Year Display' datatype='string' name='[Calculation_0603259938562053]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [completion_disclosed]&#10;    AND NOT ISNULL([completion_year])&#10;THEN STR(INT([completion_year]))&#10;ELSE &quot;Not disclosed&quot;&#10;END' />
      </column>
      <column caption='Blank Field' datatype='string' name='[Calculation_0603259941445638]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Procurement Strategy Name' datatype='string' name='[Calculation_0603259944001544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([procurement_strategy_name])&#10;    OR TRIM([procurement_strategy_name]) = &quot;&quot;&#10;THEN &quot;Not disclosed&quot;&#10;ELSE [procurement_strategy_name]&#10;END' />
      </column>
      <column caption='Construction Start Period' datatype='string' name='[Calculation_0603259944120329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([construction_start_period])&#10;    OR TRIM([construction_start_period]) = &quot;&quot;&#10;THEN &quot;Not disclosed&quot;&#10;ELSE [construction_start_period]&#10;END' />
      </column>
      <column caption='Construction End Period' datatype='string' name='[Calculation_0603259944194058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([construction_end_period])&#10;    OR TRIM([construction_end_period]) = &quot;&quot;&#10;THEN &quot;Not disclosed&quot;&#10;ELSE [construction_end_period]&#10;END' />
      </column>
      <column caption='Construction Procurement' datatype='integer' name='[Calculation_0603259952005132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_0603259932229632] = &quot;Construction Procurement&quot;&#10;    THEN [master_project_id (project_register.csv)]&#10;    END&#10;)' />
      </column>
      <column caption='FY2026–27 Allocation' datatype='integer' default-format='c&quot;$&quot;#,##0,,,.00B' name='[Calculation_0603259958812685]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='SUM(&#10;    IF [budget_year] = &quot;2026-27&quot;&#10;    THEN [annual_allocation_000]&#10;    END&#10;) * 1000' />
      </column>
      <column caption='Timeline Confirmation Coverage' datatype='real' default-format='p0.00%' name='[Calculation_0603259959181326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [timing_status] = &quot;Confirmed&quot;&#10;    THEN [master_project_id (project_timeline.csv)]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    [master_project_id (project_timeline.csv)]&#10;)' />
      </column>
      <column caption='Value Disclosure Coverage' datatype='real' default-format='p0.00%' name='[Calculation_0603259959480335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF NOT ISNULL([estimated_value_band])&#10;        AND [estimated_value_band] &lt;&gt; &quot;To be advised&quot;&#10;    THEN [master_project_id (project_register.csv)]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    [master_project_id (project_register.csv)]&#10;)' />
      </column>
      <column caption='Annual Capital Allocation' datatype='integer' default-format='c&quot;$&quot;#,##0,,,.00B;-&quot;$&quot;#,##0,,,.00B' name='[Calculation_0603260201353237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([annual_allocation_000]) * 1000' />
      </column>
      <column caption='Budget Project' datatype='integer' name='[Calculation_0603260202115094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([project_id])' />
      </column>
      <column caption='Published Cost Subtotal' datatype='integer' default-format='c&quot;$&quot;#,##0,,,.00B;-&quot;$&quot;#,##0,,,.00B' name='[Calculation_0603260203577367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_total_cost_000]) * 1000' />
      </column>
      <column caption='Expenditure Disclosure Coverage' datatype='real' default-format='p0.0%' name='[Calculation_0603260208291864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [expenditure_disclosed]&#10;    THEN [project_id]&#10;    END&#10;)&#10;/&#10;COUNTD([project_id])' />
      </column>
      <column caption='Program Group' datatype='string' name='[Calculation_0603260223737883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([program_group])&#10;    OR TRIM([program_group]) = &quot;&quot;&#10;THEN &quot;Not disclosed&quot;&#10;ELSE [program_group]&#10;END' />
      </column>
      <column caption='Timeline Projects' datatype='integer' name='[Calculation_0603260264894492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([tfnsw_project_id])' />
      </column>
      <column caption='# Construction &amp; Commision ' datatype='integer' name='[Calculation_0603260265205789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [stage_name] = &quot;Construction and commissioning&quot;&#10;    THEN [tfnsw_project_id]&#10;    END&#10;)' />
      </column>
      <column caption='Confirmed Timeline Coverage' datatype='real' default-format='p0.0%' name='[Calculation_0603260265500702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [timing_status] = &quot;Confirmed&quot;&#10;    THEN [tfnsw_project_id]&#10;    END&#10;)&#10;/&#10;COUNTD([tfnsw_project_id])' />
      </column>
      <column caption='Projects with Timing to Be Confirmed' datatype='integer' name='[Calculation_0603260265840671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [timing_status] = &quot;To be confirmed&quot;&#10;    THEN [tfnsw_project_id]&#10;    END&#10;)' />
      </column>
      <column caption='Project with unpublished staging' datatype='integer' name='[Calculation_0603260266131488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [stage_name] = &quot;Project staging not yet available&quot;&#10;    THEN [tfnsw_project_id]&#10;    END&#10;)' />
      </column>
      <column caption='Timeline Start Date' datatype='date' name='[Calculation_0603260283056161]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(&#10;    INT(RIGHT([start_quarter], 4)),&#10;    (INT(MID([start_quarter], 2, 1)) - 1) * 3 + 1,&#10;    1&#10;)' />
      </column>
      <column caption='Timeline End Date' datatype='date' name='[Calculation_0603260283392035]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(&#10;    INT(RIGHT([end_quarter], 4)),&#10;    (INT(MID([end_quarter], 2, 1)) - 1) * 3 + 1,&#10;    1&#10;)' />
      </column>
      <column caption='Timeline Duration Days' datatype='integer' name='[Calculation_0603260284166180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;day&apos;,&#10;    [Calculation_0603260283056161],&#10;    DATEADD(&apos;quarter&apos;, 1, [Calculation_0603260283392035])&#10;)' />
      </column>
      <column caption='Cost Disclosure Coverage ' datatype='real' default-format='p0.0%' name='[Expenditure Disclosure Coverage (copy)_0603260210319385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [total_cost_disclosed]&#10;    THEN [project_id]&#10;    END&#10;)&#10;/&#10;COUNTD([project_id])' />
      </column>
      <column caption='Project Completion Disclosure Status ' datatype='string' name='[Value Disclosure Status (copy)_0603259945709579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_0603259938562053])&#10;    OR [Calculation_0603259938562053] = &quot;To be advised&quot;&#10;THEN &quot;Not disclosed&quot;&#10;ELSE &quot;Value disclosed&quot;&#10;END' />
      </column>
