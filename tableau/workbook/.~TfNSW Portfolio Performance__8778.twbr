            <column caption='Timeline Start Date' datatype='date' name='[Calculation_0603260283056161]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE(&#10;    INT(RIGHT([start_quarter], 4)),&#10;    (INT(MID([start_quarter], 2, 1)) - 1) * 3 + 1,&#10;    1&#10;)' />
            </column>
            <column caption='Timeline End Date' datatype='date' name='[Calculation_0603260283392035]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE(&#10;    INT(RIGHT([end_quarter], 4)),&#10;    (INT(MID([end_quarter], 2, 1)) - 1) * 3 + 1,&#10;    1&#10;)' />
            </column>
